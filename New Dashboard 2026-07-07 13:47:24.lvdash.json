        {
          "widget": {
            "name": "470ffc34",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "2c0e99df",
                  "fields": [
                    {
                      "name": "monthly(transaction_date)",
                      "expression": "DATE_TRUNC(\"MONTH\", `transaction_date`)"
                    },
                    {
                      "name": "sum(net_amount_inr)",
                      "expression": "SUM(`net_amount_inr`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "frame": {
                "title": "Monthly Sales Trends",
                "showTitle": true
              },
              "mark": {
                "layout": "stack"
              },
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "monthly(transaction_date)",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "sum(net_amount_inr)",
                  "format": {
                    "type": "number-currency",
                    "abbreviation": "compact",
                    "currencyCode": "INR"
                  },
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
